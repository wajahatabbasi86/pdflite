<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No storage permissions requested. All file access goes through the
      Storage Access Framework (SAF) via ACTION_OPEN_DOCUMENT / ACTION_CREATE_DOCUMENT,
      per docs/REQUIREMENTS.md §1.1 — no raw file paths, no broad storage permission.
    -->

    <application
        android:name=".EasyDocApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EasyDoc">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.EasyDoc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets EasyDoc appear in the system "Open with" chooser for any PDF —
                 tapping a PDF in Files, Downloads, an email attachment, etc. can open
                 straight into View PDF. android:launchMode="singleTask" above means a
                 PDF opened while the app is already running reuses the same instance
                 (via onNewIntent) instead of stacking a second one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

    </application>

</manifest>
