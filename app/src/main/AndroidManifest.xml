<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No storage permissions requested. All file access goes through the
      Storage Access Framework (SAF) via ACTION_OPEN_DOCUMENT / ACTION_CREATE_DOCUMENT,
      per docs/REQUIREMENTS.md §1.1 — no raw file paths, no broad storage permission.
    -->

    <!-- Needed by AdMob (banner fetch) and Play Billing (purchase flow), §7. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Requested only when the user taps "Take Photo" on Image(s) -> PDF — a normal,
         user-initiated runtime permission, not a broad grant. The photo itself is captured
         straight into this app's own cache (via the FileProvider below) and immediately fed
         into the same content:// Uri pipeline every gallery-picked image already goes
         through — no separate code path, no extra storage access. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".TrenDocApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrenDoc">

        <!--
          Google's published TEST AdMob App ID — safe to ship in debug/dev builds, never
          serves real ads. MUST be swapped for the real AdMob App ID from the Play Console
          before a production release (see docs/REQUIREMENTS.md §7).
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TrenDoc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets TrenDoc appear in the system "Open with" chooser for any PDF —
                 tapping a PDF in Files, Downloads, an email attachment, etc. can open
                 straight into View PDF. android:launchMode="singleTask" above means a
                 PDF opened while the app is already running reuses the same instance
                 (via onNewIntent) instead of stacking a second one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Hands the system camera app a writable content:// Uri for a captured photo,
             without granting it (or anything else) broader file access — scoped to exactly
             this one temp file, per the same SAF-first spirit as §1.1. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.trendoc.pdflite.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
