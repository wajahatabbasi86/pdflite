<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No storage permissions requested. All file access goes through the
      Storage Access Framework (SAF) via ACTION_OPEN_DOCUMENT / ACTION_CREATE_DOCUMENT,
      per docs/REQUIREMENTS.md §1.1 — no raw file paths, no broad storage permission.
    -->

    <!-- Needed by AdMob (banner fetch) and Play Billing (purchase flow), §7. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".EasyDocApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EasyDoc">

        <!--
          Google's published TEST AdMob App ID — safe to ship in debug/dev builds, never
          serves real ads. MUST be swapped for the real AdMob App ID from the Play Console
          before a production release (see docs/REQUIREMENTS.md §7).
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.EasyDoc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets EasyDoc appear in the system "Open with" chooser for any PDF —
                 tapping a PDF in Files, Downloads, an email attachment, etc. can open
                 straight into View PDF. android:launchMode="singleTask" above means a
                 PDF opened while the app is already running reuses the same instance
                 (via onNewIntent) instead of stacking a second one. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

    </application>

</manifest>
